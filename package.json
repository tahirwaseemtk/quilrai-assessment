{
  "name": "quilr-assessment",
  "version": "0.1.0",
  "private": true,
  "description": "QuilrAI AI Field Developer / Solutions Engineer assessment: MCP server, MCP gateway, streaming PII guardrail, rate-limit router.",
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "task1": "tsx --env-file-if-exists=.env task1-mcp-server/index.ts",
    "task2:mock": "tsx --env-file-if-exists=.env task2-mcp-gateway/mock-downstream/index.ts",
    "test": "vitest run --passWithNoTests",
    "test:task1": "vitest run task1-mcp-server",
    "test:task2": "vitest run task2-mcp-gateway",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm test"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.2",
    "better-sqlite3": "13.0.3",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/better-sqlite3": "9.6.0",
    "@types/node": "22.20.5",
    "eslint": "10.14.0",
    "eslint-config-prettier": "10.1.8",
    "prettier": "3.9.10",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1",
    "vitest": "5.1.0"
  }
}
