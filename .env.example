# Task 2: MCP gateway
GATEWAY_PORT=8080
DOWNSTREAM_MCP_URL=http://127.0.0.1:8081/mcp
DOWNSTREAM_TIMEOUT_MS=5000
# JSON map of token -> role. Replace with your own random values.
GATEWAY_TOKENS={"replace-with-admin-token":"admin","replace-with-viewer-token":"viewer"}
DOWNSTREAM_AUTH_TOKEN=replace-with-downstream-token

# Task 3: stream guardrail
GUARDRAIL_PORT=8090
LLM_PROVIDER_URL=http://127.0.0.1:8091/v1/chat/completions
LLM_PROVIDER_API_KEY=replace-me

# Task 4: rate-limit router
ROUTER_PORT=8100
SQLITE_PATH=data/rate-limit.db
RATE_LIMIT_TOKENS=50000
RATE_LIMIT_WINDOW_MS=60000
PRIMARY_MODEL_URL=http://127.0.0.1:8101/v1/completions
PRIMARY_API_KEY=replace-me
PRIMARY_TIMEOUT_MS=3000
SECONDARY_MODEL_URL=http://127.0.0.1:8102/v1/completions
SECONDARY_API_KEY=replace-me
SECONDARY_TIMEOUT_MS=3000

# Shared
LOG_LEVEL=info
